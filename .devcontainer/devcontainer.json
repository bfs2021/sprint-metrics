{
  "name": "sprint-metrics",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "containerEnv": {
    "SPRINT_METRICS_DB": "postgresql://postgres:postgres@postgres:5432/sprint_metrics"
  },
  "setupCommands": [
    ["sh", "-c", "pip install --user uv && $HOME/.local/bin/uv sync --extra dev"]
  ]
}
